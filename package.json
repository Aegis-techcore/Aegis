{
  "name": "agency-website",
  "version": "0.0.0",
  "private": true,
  "description": "Aegis website built with Next.js.",
  "homepage": "https://github.com/Aegis-techcore/Aegis#readme",
  "bugs": {
    "url": "https://github.com/Aegis-techcore/Aegis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aegis-techcore/Aegis.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "start": "next start",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:import-json": "node scripts/import-json-data.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/postcss": "^4.3.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.16.0",
    "stripe": "^22.3.2",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.6.3",
    "@types/react": "19.2.17",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "typescript": "7.0.2"
  }
}
